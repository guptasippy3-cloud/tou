{
  "name": "tou-android-game",
  "version": "1.0.0",
  "private": true,
  "description": "Tou offline Android and iOS pet game",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node tests/experience.cjs 1 && node tests/experience.cjs 2 && node tests/experience.cjs 3",
    "android:sync": "node scripts/build.mjs && cap sync android",
    "android:open": "cap open android",
    "android:apk": "node scripts/build.mjs && cap sync android && cd android && ./gradlew assembleDebug",
    "ios:sync": "node scripts/build.mjs && cap sync ios",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/preferences": "^8.0.1",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "esbuild": "^0.28.2"
  }
}
